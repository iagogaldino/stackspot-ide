{
  "name": "myide",
  "version": "1.0.0",
  "description": "IDE simples para projetos Angular",
  "main": "dist/main/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:main": "npx --package=typescript tsc -p tsconfig.main.json && node scripts/copy-preload.js",
    "build:all": "npm run build && npm run build:main",
    "build:electron": "npm run build:all && electron-builder",
    "electron": "electron .",
    "electron:dev": "npm run build:main && concurrently \"npm start\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:pack": "npm run build:all && electron-builder",
    "postinstall": "electron-builder install-app-deps || true",
    "install:extension": "node scripts/install-extension.js",
    "install:extension:ps1": "powershell -ExecutionPolicy Bypass -File scripts/install-extension.ps1"
  },
  "keywords": [
    "angular",
    "electron",
    "ide",
    "monaco-editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "chokidar": "^3.6.0",
    "fs-extra": "^11.2.0",
    "marked": "^16.4.1",
    "monaco-editor": "^0.44.0",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.6.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zone.js": "^0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.24",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "~5.4.2",
    "wait-on": "^7.2.0"
  }
}
